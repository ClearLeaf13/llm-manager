{
  "name": "llm-manager",
  "version": "1.3.2",
  "description": "本地 LLM 聚合管理 — 统一管理 llama.cpp 与 NInfer 推理引擎",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "test": "node tests/renderer-structure.test.js && node tests/renderer-behavior.test.js && node tests/ctx-running.test.js",
    "test:live": "electron tests/render-live.js",
    "test:artifact": "node tests/verify-artifact.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.llm.manager",
    "productName": "本地LLM聚合管理",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "LLM-Manager-v${version}.exe"
    }
  }
}
